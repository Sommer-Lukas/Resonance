.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.omo/
data/
outputs/

# Unreal: generated executables, caches, temporary builds, logs and autosaves.
# Match nested projects and source plugins as well.
unreal/**/Binaries/
unreal/**/DerivedDataCache/
unreal/**/Intermediate/
unreal/**/Saved/

# Unreal: local developer content and per-user editor settings.
unreal/**/Content/Developers/
unreal/**/Config/DefaultEditorPerProjectUserSettings.ini

# Unreal: generated IDE projects and local IDE state.
unreal/**/.vs/
unreal/**/.vscode/
unreal/**/.idea/
unreal/**/*.sln
unreal/**/*.suo
unreal/**/*.user
unreal/**/*.userosscache
unreal/**/*.sln.docstates
unreal/**/*.vcxproj
unreal/**/*.vcxproj.filters
unreal/**/*.vcxproj.user
unreal/**/*.VC.db
unreal/**/*.VC.opendb
unreal/**/*.code-workspace
unreal/**/.DS_Store
unreal/**/Thumbs.db

# Keep .uproject, Config, Content, Source, Plugins and Build resources tracked.

# Local upstream MCP checkout; the installed source plugin is shared separately.
/unreal/unreal-mcp/

# Locally installed NVIDIA binaries/model weights retain their vendor licenses.
/unreal/ResonanceVR/Models/
/unreal/ResonanceVR/Plugins/NV_ACE_Reference/
/unreal/ResonanceVR/Plugins/NvAudio2Face*/
